{
 "name": "IC Lead Source",
 "module": "Instacertify",
 "autoname": "field:source_name",
 "naming_rule": "By fieldname",
 "allow_rename": 1,
 "track_changes": 1,
 "title_field": "source_name",
 "search_fields": "source_name",
 "sort_field": "sort_order",
 "sort_order": "ASC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Lead Source",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Sort Order",
   "default": "100",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1,
   "report": 1, "export": 1, "share": 1, "print": 1, "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1, "write": 1, "create": 1, "delete": 1,
   "report": 1, "export": 1, "share": 1, "print": 1, "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1, "write": 1, "create": 1, "delete": 0,
   "report": 1, "export": 1, "share": 1, "print": 1, "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1, "write": 0, "create": 0, "delete": 0,
   "report": 1, "export": 0, "share": 0, "print": 1, "email": 0
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1, "write": 0, "create": 0, "delete": 0,
   "report": 1, "export": 0, "share": 0, "print": 1, "email": 0
  },
  {
   "doctype": "DocPerm",
   "role": "Sales User",
   "read": 1, "write": 0, "create": 0, "delete": 0,
   "report": 1, "export": 0, "share": 0, "print": 0, "email": 0
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
