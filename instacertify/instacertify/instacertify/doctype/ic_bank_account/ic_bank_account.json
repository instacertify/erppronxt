{
 "name": "IC Bank Account",
 "module": "Instacertify",
 "autoname": "field:account_title",
 "naming_rule": "By fieldname",
 "title_field": "account_title",
 "search_fields": "bank_name,account_number,ifsc_code",
 "sort_field": "account_title",
 "sort_order": "ASC",
 "track_changes": 1,
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "account_title",
   "fieldtype": "Data",
   "label": "Account Title",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1,
   "bold": 1,
   "description": "Shown in the quote Bank selector (e.g. YES BANK, Indian Overseas Bank)"
  },
  {
   "doctype": "DocField",
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Default Account",
   "default": 0,
   "in_list_view": 1,
   "description": "Used on new quotes when none is selected"
  },
  {
   "doctype": "DocField",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_top",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "gstin",
   "fieldtype": "Data",
   "label": "GSTIN",
   "default": "09AAGCI8396C1Z7"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_details",
   "fieldtype": "Section Break",
   "label": "Bank Detail for the Transaction"
  },
  {
   "doctype": "DocField",
   "fieldname": "beneficiary_name",
   "fieldtype": "Data",
   "label": "Beneficiary",
   "reqd": 1,
   "default": "Instacertify Labs Private Limited",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "bank_name",
   "fieldtype": "Data",
   "label": "Bank Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "account_number",
   "fieldtype": "Data",
   "label": "Account No",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_details",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "ifsc_code",
   "fieldtype": "Data",
   "label": "IFSC Code",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "swift_code",
   "fieldtype": "Data",
   "label": "SWIFT Code",
   "description": "For international / USD transfers"
  },
  {
   "doctype": "DocField",
   "fieldname": "upi_id",
   "fieldtype": "Data",
   "label": "UPI ID",
   "description": "Leave blank to hide UPI row on print"
  },
  {
   "doctype": "DocField",
   "fieldname": "branch_address",
   "fieldtype": "Small Text",
   "label": "Branch"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 1,
   "email": 0
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 0,
   "create": 0,
   "delete": 0,
   "report": 0,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
