{
 "name": "IC Report Share",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "is_submittable": 0,
 "track_changes": 1,
 "title_field": "title",
 "search_fields": "customer,access_code,file_name",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "RSH-.YYYY.-.####",
   "default": "RSH-.YYYY.-.####",
   "reqd": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nRevoked",
   "default": "Active",
   "in_list_view": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "doctype": "DocField"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "shared_on",
   "fieldtype": "Datetime",
   "label": "Shared On",
   "read_only": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "shared_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Shared By",
   "read_only": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "section_file",
   "fieldtype": "Section Break",
   "label": "Report File",
   "doctype": "DocField"
  },
  {
   "fieldname": "file_url",
   "fieldtype": "Attach",
   "label": "Report File",
   "reqd": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "file_name",
   "fieldtype": "Data",
   "label": "File Name",
   "in_list_view": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break",
   "doctype": "DocField"
  },
  {
   "fieldname": "source_doctype",
   "fieldtype": "Data",
   "label": "Source Type",
   "read_only": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "source_name",
   "fieldtype": "Data",
   "label": "Source",
   "read_only": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "section_share",
   "fieldtype": "Section Break",
   "label": "Share Access",
   "doctype": "DocField"
  },
  {
   "fieldname": "share_token",
   "fieldtype": "Data",
   "label": "Share Token",
   "read_only": 1,
   "unique": 1,
   "bold": 1,
   "doctype": "DocField"
  },
  {
   "fieldname": "access_code",
   "fieldtype": "Data",
   "label": "Access Code (8 digits)",
   "read_only": 1,
   "bold": 1,
   "in_list_view": 1,
   "description": "Customer enters this 8-digit code on the share link to view or download the report.",
   "doctype": "DocField"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break",
   "doctype": "DocField"
  },
  {
   "fieldname": "share_url",
   "fieldtype": "Small Text",
   "label": "Share Link",
   "read_only": 1,
   "doctype": "DocField"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "Sales User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "Projects User",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 1,
   "email": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
