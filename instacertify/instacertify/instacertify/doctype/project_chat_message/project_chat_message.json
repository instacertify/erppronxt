{
 "name": "Project Chat Message",
 "autoname": "hash",
 "module": "Instacertify",
 "track_changes": 0,
 "title_field": "message",
 "sort_field": "creation",
 "sort_order": "ASC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "sender",
