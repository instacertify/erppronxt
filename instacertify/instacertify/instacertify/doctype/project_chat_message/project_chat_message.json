   "options": "User",
   "label": "Sender",
   "default": "__user",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "sender_name",
   "fieldtype": "Data",
   "label": "Sender Name",
   "read_only": 1,
   "fetch_from": "sender.full_name"
  },
  {
