  },
  {
   "doctype": "DocField",
   "fieldname": "message_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Chat\nNote\nMention",
   "default": "Chat",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Attachment"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_message",
   "fieldtype": "Section Break",
   "label": "Message"
  },
  {
   "doctype": "DocField",
   "fieldname": "message",
   "fieldtype": "Text Editor",
   "label": "Message",
   "reqd": 1
  }
 ],
