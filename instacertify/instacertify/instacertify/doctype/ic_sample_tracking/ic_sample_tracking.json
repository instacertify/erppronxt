  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
