{
 "name": "IC Sample Tracking",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "sample_description",
 "search_fields": "tracking_number,customer,project,sample_description",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "SMP-.YYYY.-.####",
   "default": "SMP-.YYYY.-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "tracking_number",
   "fieldtype": "Data",
   "label": "Sample Tracking Number",
   "read_only": 1,
   "in_list_view": 1,
   "description": "Auto-generated unique tracking number"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "in_list_view": 1,
   "default": "Sample Awaited",
   "options": "Sample Awaited\nSample Received\nIn Transit to Office\nIn Transit to Lab\nAt Laboratory\nAt Instacertify Storage\nSample Dispatched to Laboratory\nTesting in Progress\nReport Available\nReport Uploaded\nReport Shared with Customer\nDiscarded"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_location",
   "fieldtype": "Select",
   "label": "Sample Location",
   "in_list_view": 1,
   "options": "\nIn Transit to Office\nIn Transit to Lab\nAt Laboratory\nAt Instacertify Storage\nDiscarded\nWith Customer",
   "description": "Physical custody of the sample"
  },
  {
   "doctype": "DocField",
   "fieldname": "qr_code",
   "fieldtype": "Attach Image",
   "label": "QR Code",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_links",
   "fieldtype": "Section Break",
   "label": "Links"
  },
  {
   "doctype": "DocField",
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project"
  },
  {
   "doctype": "DocField",
   "fieldname": "testing_request",
   "fieldtype": "Link",
   "options": "IC Testing Request",
   "label": "Testing Request"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "laboratory",
   "fieldtype": "Link",
   "options": "IC Laboratory",
   "label": "Laboratory"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_receipt",
   "fieldtype": "Section Break",
   "label": "Sample Receipt"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_received_date",
   "fieldtype": "Date",
   "label": "Sample Received Date"
  },
  {
   "doctype": "DocField",
   "fieldname": "quantity",
   "fieldtype": "Float",
   "label": "Quantity",
   "default": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_description",
   "fieldtype": "Small Text",
   "label": "Sample Description",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_condition",
   "fieldtype": "Select",
   "label": "Sample Condition",
   "options": "Good\nDamaged\nIncomplete\nOther"
  },
  {
   "doctype": "DocField",
   "fieldname": "received_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Received By"
  },
  {
   "doctype": "DocField",
   "fieldname": "dispatch_date",
   "fieldtype": "Date",
   "label": "Dispatched to Lab Date"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "remarks",
   "fieldtype": "Text Editor",
   "label": "Remarks"
  }
 ],
 "permissions": [
