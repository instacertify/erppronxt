{
 "name": "IC Expense Claim",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "title",
 "search_fields": "title,category,employee_name,status",
 "sort_field": "modified",
 "sort_order": "DESC",
 "is_submittable": 1,
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "EXP-.YYYY.-.####",
   "default": "EXP-.YYYY.-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Expense Category",
   "options": "Travel\nPetty Cash\nOffice\nConveyance\nLodging\nMeals\nCommunication\nOther",
   "reqd": 1,
   "default": "Travel",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "expense_date",
   "fieldtype": "Date",
   "label": "Expense Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nSubmitted\nApproved\nRejected\nReimbursed",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_who",
   "fieldtype": "Section Break",
   "label": "Claimant"
  },
  {
   "doctype": "DocField",
   "fieldname": "employee",
   "fieldtype": "Link",
   "options": "Employee",
   "label": "Employee"
  },
  {
   "doctype": "DocField",
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee Name",
   "fetch_from": "employee.employee_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "claimed_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Claimed By",
   "default": "__user",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project (optional)"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_amount",
   "fieldtype": "Section Break",
   "label": "Amount & Details"
  },
  {
   "doctype": "DocField",
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "currency",
   "fieldtype": "Link",
   "options": "Currency",
   "label": "Currency",
   "default": "INR"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "payment_mode",
   "fieldtype": "Select",
   "label": "Paid By",
   "options": "Self\nCompany Card\nAdvance\nOther",
   "default": "Self"
  },
  {
   "doctype": "DocField",
   "fieldname": "vendor_name",
   "fieldtype": "Data",
   "label": "Vendor / Merchant"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_desc",
   "fieldtype": "Section Break",
   "label": "Description & Receipt"
  },
  {
   "doctype": "DocField",
   "fieldname": "description",
   "fieldtype": "Text Editor",
   "label": "Description",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "receipt",
   "fieldtype": "Attach",
   "label": "Receipt / Bill",
   "description": "Upload PDF, image, or Excel of the bill"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_approval",
   "fieldtype": "Section Break",
   "label": "Approval",
   "collapsible": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "approver_remarks",
   "fieldtype": "Small Text",
   "label": "Approver Remarks"
  },
  {
   "doctype": "DocField",
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Approved By",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved On",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 1,
   "amend": 0,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "share": 1,
   "print": 1,
   "email": 1,
   "if_owner": 1
  },
  {
   "doctype": "DocPerm",
   "role": "All",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 1,
   "cancel": 0,
   "amend": 0,
   "report": 0,
   "export": 0,
   "share": 0,
   "print": 1,
   "email": 0,
   "if_owner": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
