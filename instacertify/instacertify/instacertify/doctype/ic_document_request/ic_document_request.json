{
 "name": "IC Document Request",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "title",
 "search_fields": "customer,project,title",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "DR-.YYYY.-.####",
   "default": "DR-.YYYY.-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "in_list_view": 1,
   "default": "Draft",
   "options": "Draft\nSent to Customer\nPartially Uploaded\nUnder Review\nCompleted\nCancelled"
  },
  {
   "doctype": "DocField",
   "fieldname": "share_token",
   "fieldtype": "Data",
   "label": "Share Token",
   "read_only": 1,
   "hidden": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_links",
   "fieldtype": "Section Break",
   "label": "Links"
  },
  {
   "doctype": "DocField",
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "quotation",
   "fieldtype": "Link",
   "options": "Quotation",
   "label": "Quotation"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "checklist_template",
   "fieldtype": "Link",
   "options": "IC Document Checklist Template",
   "label": "Checklist Template"
  },
  {
   "doctype": "DocField",
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "options": "User",
   "label": "Assigned To"
  },
  {
   "doctype": "DocField",
   "fieldname": "sent_on",
   "fieldtype": "Datetime",
   "label": "Sent On",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "Requested Documents"
  },
  {
   "doctype": "DocField",
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Documents",
   "options": "IC Document Request Item"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "remarks",
   "fieldtype": "Text Editor",
   "label": "Remarks"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
