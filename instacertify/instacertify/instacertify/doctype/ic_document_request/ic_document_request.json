{
 "name": "IC Document Request",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "title",
 "search_fields": "customer,project,title",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "DR-.YYYY.-.####",
   "default": "DR-.YYYY.-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "in_list_view": 1,
   "default": "Draft",
   "options": "Draft\nSent to Customer\nPartially Uploaded\nUnder Review\nCompleted\nCancelled"
  },
  {
   "doctype": "DocField",
   "fieldname": "share_token",
   "fieldtype": "Data",
   "label": "Share Token",
   "read_only": 1,
   "hidden": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_links",
   "fieldtype": "Section Break",
   "label": "Links"
  },
  {
   "doctype": "DocField",
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "quotation",
   "fieldtype": "Link",
   "options": "Quotation",
   "label": "Quotation"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "checklist_template",
   "fieldtype": "Link",
   "options": "IC Document Checklist Template",
   "label": "Collection Sheet Template"
  },
  {
   "doctype": "DocField",
   "fieldname": "share_url",
   "fieldtype": "Data",
   "label": "Customer Share Link",
   "read_only": 1,
   "description": "Generated when you Send to Customer — customer uploads files and fills fields here"
  },
  {
   "doctype": "DocField",
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "options": "User",
   "label": "Assigned To"
  },
  {
   "doctype": "DocField",
   "fieldname": "sent_on",
   "fieldtype": "Datetime",
   "label": "Sent On",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "Requested Documents"
  },
  {
   "doctype": "DocField",
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Documents",
   "options": "IC Document Request Item"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_data_collection",
   "fieldtype": "Section Break",
   "label": "Data Collection Sheet"
  },
  {
   "doctype": "DocField",
   "fieldname": "company_legal_name",
   "fieldtype": "Data",
   "label": "Company Legal Name"
  },
  {
   "doctype": "DocField",
   "fieldname": "gstin",
   "fieldtype": "Data",
   "label": "GSTIN"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_data_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "data_contact_person",
   "fieldtype": "Data",
   "label": "Contact Person"
  },
  {
   "doctype": "DocField",
   "fieldname": "data_contact_phone",
   "fieldtype": "Data",
   "label": "Contact Phone"
  },
  {
   "doctype": "DocField",
   "fieldname": "data_contact_email",
   "fieldtype": "Data",
   "label": "Contact Email"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_format_fields",
   "fieldtype": "Section Break",
   "label": "Format Fields (optional)",
   "collapsible": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "format_fields_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted\">Uncheck to hide non-mandatory built-in fields from this sheet (desk, customer portal, and print).</p>"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_company_address",
   "fieldtype": "Check",
   "label": "Company Address",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_product_name",
   "fieldtype": "Check",
   "label": "Product Name",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_product_model",
   "fieldtype": "Check",
   "label": "Model / Variant",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_product_brand",
   "fieldtype": "Check",
   "label": "Brand",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_format_fields",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_data_collection_remarks",
   "fieldtype": "Check",
   "label": "Data Collection Remarks",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_data_fields",
   "fieldtype": "Check",
   "label": "Additional Data Fields",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_sample_dispatch",
   "fieldtype": "Check",
   "label": "Sample Dispatch (legacy)",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "include_remarks",
   "fieldtype": "Check",
   "label": "Notes / Remarks",
   "default": "1"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_data_product",
   "fieldtype": "Section Break",
   "label": "Product / Application Data"
  },
  {
   "doctype": "DocField",
   "fieldname": "company_address",
   "fieldtype": "Small Text",
   "label": "Company Address"
  },
  {
   "doctype": "DocField",
   "fieldname": "product_name",
   "fieldtype": "Data",
   "label": "Product Name"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_data_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "product_model",
   "fieldtype": "Data",
   "label": "Model / Variant"
  },
  {
   "doctype": "DocField",
   "fieldname": "product_brand",
   "fieldtype": "Data",
   "label": "Brand"
  },
  {
   "doctype": "DocField",
   "fieldname": "data_collection_remarks",
   "fieldtype": "Small Text",
   "label": "Data Collection Remarks"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_data_fields",
   "fieldtype": "Section Break",
   "label": "Additional Data Fields"
  },
  {
   "doctype": "DocField",
   "fieldname": "data_fields",
   "fieldtype": "Table",
   "label": "Data Collection Fields",
   "options": "IC Data Collection Item"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_sample",
   "fieldtype": "Section Break",
   "label": "Sample Dispatch (legacy — prefer Sample Dispatch Collection Sheet)",
   "collapsible": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "courier_name",
   "fieldtype": "Data",
   "label": "Courier Name"
  },
  {
   "doctype": "DocField",
   "fieldname": "tracking_number",
   "fieldtype": "Data",
   "label": "Tracking / AWB Number",
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_sample",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "dispatch_date",
   "fieldtype": "Date",
   "label": "Dispatch Date"
  },
  {
   "doctype": "DocField",
   "fieldname": "pod_attachment",
   "fieldtype": "Attach",
   "label": "POD / Dispatch Proof"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_dispatch_remarks",
   "fieldtype": "Small Text",
   "label": "Sample Dispatch Remarks"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "remarks",
   "fieldtype": "Text Editor",
   "label": "Remarks"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
