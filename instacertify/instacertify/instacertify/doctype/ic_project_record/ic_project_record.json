{
 "name": "IC Project Record",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "subject",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "PRR-.YYYY.-.####",
   "default": "PRR-.YYYY.-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "subject",
   "fieldtype": "Data",
   "label": "Subject",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "record_type",
   "fieldtype": "Select",
   "label": "Type",
   "in_list_view": 1,
   "reqd": 1,
   "options": "Project Remark\nImportant Commitment\nIncident\nImportant Customer Note\nDocument\nDeliverable\nCertificate\nOther"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Document Category",
   "options": "Customer Documents\nApplications\nTechnical Documents\nTesting Documents\nTest Reports\nCertificates\nFinal Deliverables\nProject Records\nOther"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_content",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "doctype": "DocField",
   "fieldname": "content",
   "fieldtype": "Text Editor",
   "label": "Content"
  },
  {
   "doctype": "DocField",
   "fieldname": "attachment",
   "fieldtype": "Attach",
   "label": "Attachment"
  },
  {
   "doctype": "DocField",
   "fieldname": "recorded_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Recorded By",
   "default": "__user"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
