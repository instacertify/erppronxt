{
 "name": "IC Laboratory",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "laboratory_name",
 "search_fields": "laboratory_name,location,city,country",
 "image_field": "logo",
 "sort_field": "laboratory_name",
 "sort_order": "ASC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "LAB-.####",
   "default": "LAB-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "laboratory_name",
   "fieldtype": "Data",
   "label": "Laboratory Name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "logo",
   "fieldtype": "Attach Image",
   "label": "Logo"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Active\nInactive",
   "default": "Active",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "supplier",
   "fieldtype": "Link",
   "options": "Supplier",
   "label": "Supplier (for Purchase Invoice)",
   "description": "Link ERPNext Supplier to buy lab services without warehouse",
   "in_list_view": 0
  },
  {
   "doctype": "DocField",
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Location",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_address",
   "fieldtype": "Section Break",
   "label": "Address & Contact"
  },
  {
   "doctype": "DocField",
   "fieldname": "address",
   "fieldtype": "Small Text",
   "label": "Address"
  },
  {
   "doctype": "DocField",
   "fieldname": "city",
   "fieldtype": "Data",
   "label": "City"
  },
  {
   "doctype": "DocField",
   "fieldname": "state",
   "fieldtype": "Data",
   "label": "State"
  },
  {
   "doctype": "DocField",
   "fieldname": "country",
   "fieldtype": "Link",
   "options": "Country",
   "label": "Country"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "contact_person",
   "fieldtype": "Data",
   "label": "Contact Person"
  },
  {
   "doctype": "DocField",
   "fieldname": "email",
   "fieldtype": "Data",
   "label": "Email",
   "options": "Email"
  },
  {
   "doctype": "DocField",
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "Phone",
   "options": "Phone"
  },
  {
   "doctype": "DocField",
   "fieldname": "website",
   "fieldtype": "Data",
   "label": "Website",
   "options": "URL"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_accreditation",
   "fieldtype": "Section Break",
   "label": "Accreditation"
  },
  {
   "doctype": "DocField",
   "fieldname": "accreditation_details",
   "fieldtype": "Small Text",
   "label": "Accreditation Details",
   "description": "NABL / ISO details — editable anytime"
  },
  {
   "doctype": "DocField",
   "fieldname": "accreditation_scope",
   "fieldtype": "Small Text",
   "label": "Accreditation Scope",
   "description": "Short summary of tests / standards covered — editable anytime"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "scope_sheet",
   "fieldtype": "Attach",
   "label": "Laboratory Scope Sheet",
   "description": "PDF / Excel / CSV scope file. CSV/Excel also fill the pricing table below."
  },
  {
   "doctype": "DocField",
   "fieldname": "accreditation_certificate",
   "fieldtype": "Attach",
   "label": "Accreditation Certificate"
  },
  {
   "doctype": "DocField",
   "fieldname": "accreditation_scope_pdf",
   "fieldtype": "Attach",
   "label": "Accreditation Scope PDF"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_tests",
   "fieldtype": "Section Break",
   "label": "Accreditation Scope & Pricing Library",
   "description": "Add or edit each accredited test with buying & selling prices. All columns are editable. These drive the Testing Quotation dropdown."
  },
  {
   "doctype": "DocField",
   "fieldname": "test_scopes",
   "fieldtype": "Table",
   "label": "Scope of Accreditation & Pricing",
   "options": "IC Laboratory Test Scope"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  }
 ],
