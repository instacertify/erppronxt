{
 "name": "IC Quotation Test Item",
 "module": "Instacertify",
 "istable": 1,
 "editable_grid": 1,
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "laboratory",
   "fieldtype": "Link",
   "options": "IC Laboratory",
   "label": "Lab",
   "in_list_view": 1,
   "columns": 1,
   "description": "Select lab first — only tests/standards in that lab's scope will be suggested"
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_initials",
   "fieldtype": "Data",
   "label": "Lab Initials",
   "fetch_from": "laboratory.lab_initials",
   "read_only": 1,
   "in_list_view": 1,
   "columns": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "test_name",
   "fieldtype": "Autocomplete",
   "label": "Test Name",
   "in_list_view": 1,
   "columns": 2,
   "reqd": 0,
   "description": "Only tests in the selected lab's accreditation scope"
  },
  {
   "doctype": "DocField",
   "fieldname": "applicable_standard",
   "fieldtype": "Autocomplete",
   "label": "Standard",
   "in_list_view": 1,
   "columns": 2,
   "reqd": 0,
   "description": "Only standards offered by this lab for the selected test"
  },
  {
   "doctype": "DocField",
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Test Description",
   "description": "Shown to the customer with the test line"
  },
  {
   "doctype": "DocField",
   "fieldname": "purchase_price",
   "fieldtype": "Currency",
   "label": "Purchase Price",
   "options": "currency",
   "in_list_view": 1,
   "columns": 1,
   "description": "Lab buy / cost — editable; never shown to the customer"
  },
  {
   "doctype": "DocField",
   "fieldname": "suggested_selling_price",
   "fieldtype": "Currency",
   "label": "Suggested Selling Price",
   "options": "currency",
   "in_list_view": 1,
   "columns": 1,
   "description": "Editable selling price — shown to the customer as Price"
  },
  {
   "doctype": "DocField",
   "fieldname": "number_of_samples",
   "fieldtype": "Int",
   "label": "No. of Samples",
   "default": 1,
   "in_list_view": 1,
   "columns": 1,
   "description": "Quantity of samples for this test — Total = Suggested Selling × No. of Samples"
  },
  {
   "doctype": "DocField",
   "fieldname": "per_unit_charges",
   "fieldtype": "Currency",
   "label": "Selling Price / Unit",
   "options": "currency",
   "hidden": 1,
   "description": "Mirrors Suggested Selling Price for totals"
  },
  {
   "doctype": "DocField",
   "fieldname": "testing_charges",
   "fieldtype": "Currency",
   "label": "Total Price",
   "in_list_view": 1,
   "columns": 1,
   "options": "currency",
   "read_only": 1,
   "description": "Suggested Selling Price × No. of Samples"
  },
  {
   "doctype": "DocField",
   "fieldname": "product_name",
   "fieldtype": "Data",
   "label": "Product Name"
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_offer",
   "fieldtype": "Autocomplete",
   "label": "Lab Offer (compare)",
   "description": "Optional multi-lab price compare"
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_test_scope",
   "fieldtype": "Autocomplete",
   "label": "Lab Test / Pricing",
   "hidden": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_scope_row",
   "fieldtype": "Data",
   "label": "Lab Scope Row",
   "read_only": 1,
   "hidden": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_requirement",
   "fieldtype": "Small Text",
   "label": "Sample Requirement"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_type",
   "fieldtype": "Data",
   "label": "Sample Type"
  },
  {
   "doctype": "DocField",
   "fieldname": "laboratory_location",
   "fieldtype": "Data",
   "label": "Laboratory Location",
   "fetch_from": "laboratory.location",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "laboratory_accreditation",
   "fieldtype": "Small Text",
   "label": "Laboratory Accreditation",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "testing_timeline",
   "fieldtype": "Data",
   "label": "Testing Timeline"
  },
  {
   "doctype": "DocField",
   "fieldname": "currency",
   "fieldtype": "Link",
   "options": "Currency",
   "label": "Currency",
   "hidden": 1
  }
 ],
 "permissions": [],
 "doctype": "DocType",
 "engine": "InnoDB"
}
