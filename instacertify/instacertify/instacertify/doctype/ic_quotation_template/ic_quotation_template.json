{
 "name": "IC Quotation Template",
 "autoname": "field:template_name",
 "naming_rule": "By fieldname",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "template_name",
 "search_fields": "template_name,quotation_type,service_family,service_name",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "quotation_type",
   "fieldtype": "Select",
   "label": "Template Type",
   "options": "Consulting\nTesting\nRenewal\nOther\nMultiple Products / Multiple Services\nService",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Consulting, Testing, or Renewal — create as many templates as needed per type."
  },
  {
   "doctype": "DocField",
   "fieldname": "service_family",
   "fieldtype": "Data",
   "label": "Service Family / Subtype",
   "description": "e.g. BIS CRS, TEC, WPC, EMC, Safety, IP65, BIS Renewal",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "template_notes",
   "fieldtype": "Small Text",
   "label": "Template Notes",
   "description": "Internal note shown when selecting this template"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_upload_library",
   "fieldtype": "Section Break",
   "label": "Upload Quote Format Library",
   "description": "Upload PDF / DOCX / HTML quote formats and supporting template packs for this library entry."
  },
  {
   "doctype": "DocField",
   "fieldname": "uploaded_format",
   "fieldtype": "Attach",
   "label": "Primary Quote Format",
   "description": "Main printable quote format file (PDF, DOCX, HTML)"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_upload_library",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "uploaded_template_pack",
   "fieldtype": "Attach",
   "label": "Template Pack / Extra File",
   "description": "Optional second file (scope sheet, annex, zip pack)"
  },
  {
   "doctype": "DocField",
   "fieldname": "format_library",
   "fieldtype": "Table",
   "label": "Format Library Files",
   "options": "IC Quote Format File",
   "description": "Add multiple quote format files to this template library"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_service",
   "fieldtype": "Section Break",
   "label": "Service / Consulting / Renewal",
   "depends_on": "eval:in_list(['Consulting','Renewal','Service','Other','Multiple Products / Multiple Services'], doc.quotation_type)"
  },
  {
   "doctype": "DocField",
   "fieldname": "service_name",
   "fieldtype": "Data",
   "label": "Service / Consultancy Title"
  },
  {
   "doctype": "DocField",
   "fieldname": "certification_type",
   "fieldtype": "Data",
   "label": "Certification Type"
  },
  {
   "doctype": "DocField",
   "fieldname": "applicable_standard",
   "fieldtype": "Data",
   "label": "Applicable Standard"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "estimated_timeline",
   "fieldtype": "Data",
   "label": "Estimated Timeline"
  },
  {
   "doctype": "DocField",
   "fieldname": "validity_days",
   "fieldtype": "Int",
   "label": "Validity (Days)",
   "default": 90
  },
  {
   "doctype": "DocField",
   "fieldname": "section_consulting_narrative",
   "fieldtype": "Section Break",
   "label": "Consulting Narrative (Editable)"
  },
  {
   "doctype": "DocField",
   "fieldname": "about_service",
   "fieldtype": "Text Editor",
   "label": "ABOUT"
  },
  {
   "doctype": "DocField",
   "fieldname": "standard_narrative",
   "fieldtype": "Text Editor",
   "label": "Standard Applicable (Narrative)"
  },
  {
   "doctype": "DocField",
   "fieldname": "process_steps",
   "fieldtype": "Text Editor",
   "label": "Process Steps"
  },
  {
   "doctype": "DocField",
   "fieldname": "validity_text",
   "fieldtype": "Text Editor",
   "label": "Validity of Registration / Service"
  },
  {
   "doctype": "DocField",
   "fieldname": "timeline_details",
   "fieldtype": "Text Editor",
   "label": "Timelines (Detailed)"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_required",
   "fieldtype": "Text Editor",
   "label": "Sample Required"
  },
  {
   "doctype": "DocField",
   "fieldname": "documents_required",
   "fieldtype": "Text Editor",
   "label": "Documents Required"
  },
  {
   "doctype": "DocField",
   "fieldname": "commercials_notes",
   "fieldtype": "Text Editor",
   "label": "Commercials Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_scope",
   "fieldtype": "Section Break",
   "label": "Scope & Deliverables"
  },
  {
   "doctype": "DocField",
   "fieldname": "scope_of_work",
   "fieldtype": "Text Editor",
   "label": "Scope of Work"
  },
  {
   "doctype": "DocField",
   "fieldname": "deliverables",
   "fieldtype": "Text Editor",
   "label": "Deliverables"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_policies",
   "fieldtype": "Section Break",
   "label": "Policies"
  },
  {
   "doctype": "DocField",
   "fieldname": "payment_terms",
   "fieldtype": "Text Editor",
   "label": "Payment Terms"
  },
  {
   "doctype": "DocField",
   "fieldname": "cancellation_policy",
   "fieldtype": "Text Editor",
   "label": "Cancellation & Refund Policy"
  },
  {
   "doctype": "DocField",
   "fieldname": "confidentiality",
   "fieldtype": "Text Editor",
   "label": "Confidentiality & Data Protection"
  },
  {
   "doctype": "DocField",
   "fieldname": "terms_and_conditions",
   "fieldtype": "Text Editor",
   "label": "Terms and Conditions"
  },
  {
   "doctype": "DocField",
   "fieldname": "force_majeure",
   "fieldtype": "Text Editor",
   "label": "Force Majeure"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_testing_narrative",
   "fieldtype": "Section Break",
   "label": "Testing Narrative",
   "depends_on": "eval:doc.quotation_type=='Testing' || doc.quotation_type=='Multiple Products / Multiple Services'"
  },
  {
   "doctype": "DocField",
   "fieldname": "subject",
   "fieldtype": "Data",
   "label": "Subject",
   "default": "Testing"
  },
  {
   "doctype": "DocField",
   "fieldname": "about_testing",
   "fieldtype": "Text Editor",
   "label": "ABOUT (Testing)"
  },
  {
   "doctype": "DocField",
   "fieldname": "applicable_standards_text",
   "fieldtype": "Text Editor",
   "label": "Applicable Standards (Narrative)"
  },
  {
   "doctype": "DocField",
   "fieldname": "samples_note",
   "fieldtype": "Small Text",
   "label": "Samples Note"
  },
  {
   "doctype": "DocField",
   "fieldname": "gst_note",
   "fieldtype": "Data",
   "label": "GST Note"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_handling_policy",
   "fieldtype": "Text Editor",
   "label": "Sample Handling & Disposal Policy"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_cost",
   "fieldtype": "Section Break",
   "label": "Default Cost / Commercials"
  },
  {
   "doctype": "DocField",
   "fieldname": "cost_items",
   "fieldtype": "Table",
   "label": "Cost Items",
   "options": "IC Quotation Cost Item"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_testing",
   "fieldtype": "Section Break",
   "label": "Default Testing Structure",
   "depends_on": "eval:doc.quotation_type=='Testing' || doc.quotation_type=='Multiple Products / Multiple Services'"
  },
  {
   "doctype": "DocField",
   "fieldname": "test_items",
   "fieldtype": "Table",
   "label": "Test Items",
   "options": "IC Quotation Test Item"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
