{
 "name": "IC Quotation Template",
 "autoname": "field:template_name",
 "naming_rule": "By fieldname",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "display_name",
 "search_fields": "display_name,template_name,quotation_type,service_family,service_name",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "section_identity",
   "fieldtype": "Section Break",
   "label": "1. Template Identity",
   "description": "Change Display Name anytime \u2014 it does not affect quotes already linked to this template. Template ID stays fixed for the system hierarchy."
  },
  {
   "doctype": "DocField",
   "fieldname": "display_name",
   "fieldtype": "Data",
   "label": "Display Name",
   "reqd": 0,
   "in_list_view": 1,
   "bold": 1,
   "description": "Shown in Quote Format Library and when creating a quotation. Change freely \u2014 does not break existing quotes."
  },
  {
   "doctype": "DocField",
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template ID",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 0,
   "bold": 0,
   "description": "Internal system ID (stable). Set once when creating; use Display Name to rename what users see."
  },
  {
   "doctype": "DocField",
   "fieldname": "quotation_type",
   "fieldtype": "Select",
   "label": "Major Category",
   "options": "Consulting\nTesting\nRenewal\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Consulting, Testing, Renewal, or Other \u2014 used when creating a quote."
  },
  {
   "doctype": "DocField",
   "fieldname": "service_family",
   "fieldtype": "Data",
   "label": "Service Family / Subtype",
   "description": "e.g. BIS CRS, TEC, WPC, EMC, Safety, IP65, BIS Renewal",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "template_notes",
   "fieldtype": "Small Text",
   "label": "Template Notes",
   "description": "Internal note shown when selecting this template. Tags: add [Tags: bis, crs] for library filters."
