   "collapsible": 1,
   "description": "Change the printed section names (ABOUT, Commercials, Payment Terms, etc.). Leave blank to use the default heading. Applied to new quotations from this template."
  },
  {
   "doctype": "DocField",
   "fieldname": "label_about",
   "fieldtype": "Data",
   "label": "Heading: About",
   "description": "Default: ABOUT",
   "placeholder": "ABOUT"
  },
  {
   "doctype": "DocField",
   "fieldname": "label_standard",
   "fieldtype": "Data",
   "label": "Heading: Standard Applicable",
   "description": "Default: STANDARD APPLICABLE",
   "placeholder": "STANDARD APPLICABLE"
  },
  {
   "doctype": "DocField",
   "fieldname": "label_process",
