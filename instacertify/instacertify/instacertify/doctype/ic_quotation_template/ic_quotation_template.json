   "fieldname": "show_force_majeure",
   "fieldtype": "Check",
   "label": "Show Force Majeure",
   "default": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "show_confidentiality",
   "fieldtype": "Check",
