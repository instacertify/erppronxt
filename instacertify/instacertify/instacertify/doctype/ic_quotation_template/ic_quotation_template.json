  },
  {
   "doctype": "DocField",
   "fieldname": "label_timelines",
   "fieldtype": "Data",
   "label": "Heading: Timelines",
   "placeholder": "Timelines"
  },
  {
   "doctype": "DocField",
   "fieldname": "label_sample_required",
   "fieldtype": "Data",
   "label": "Heading: Sample Required",
   "placeholder": "SAMPLE REQUIRED"
