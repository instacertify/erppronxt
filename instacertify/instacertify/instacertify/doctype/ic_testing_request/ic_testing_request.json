{
 "name": "IC Testing Request",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "module": "Instacertify",
 "is_submittable": 0,
 "track_changes": 1,
 "track_seen": 1,
 "title_field": "title",
 "search_fields": "customer,project,product,test_name",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "TR-.YYYY.-.####",
   "default": "TR-.YYYY.-.####",
   "reqd": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "in_list_view": 1,
   "default": "Testing Request Created",
   "options": "Testing Request Created\nSample Awaited\nSample Received\nSample Dispatched to Laboratory\nTesting in Progress\nReport Available\nReport Uploaded\nReport Shared with Customer"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_links",
   "fieldtype": "Section Break",
   "label": "Links"
  },
  {
   "doctype": "DocField",
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "project",
   "fieldtype": "Link",
   "options": "Project",
   "label": "Project",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "quotation",
   "fieldtype": "Link",
   "options": "Quotation",
   "label": "Quotation",
   "description": "Optional — map to the related quotation. Shown in Customer records.",
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "assigned_person",
   "fieldtype": "Link",
   "options": "User",
   "label": "Primary Assignee",
   "in_list_view": 1,
   "read_only": 1,
   "description": "Auto-set from the Primary person in Assign People"
  },
  {
   "doctype": "DocField",
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "Low\nMedium\nHigh\nUrgent",
   "default": "Medium"
  },
  {
   "doctype": "DocField",
   "fieldname": "testing_timeline",
   "fieldtype": "Data",
   "label": "Testing Timeline"
  },
  {
   "doctype": "DocField",
   "fieldname": "expected_completion",
   "fieldtype": "Date",
   "label": "Expected Completion"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_assignees",
   "fieldtype": "Section Break",
   "label": "Assigned Team \u2014 one or more people"
  },
  {
   "doctype": "DocField",
   "fieldname": "ic_assignees",
   "fieldtype": "Table",
   "label": "Assign People",
   "options": "IC Assignee",
   "description": "Add everyone on this testing request. Mark one as Primary."
  },
  {
   "doctype": "DocField",
   "fieldname": "section_product",
   "fieldtype": "Section Break",
   "label": "Product & Test"
  },
  {
   "doctype": "DocField",
   "fieldname": "product",
   "fieldtype": "Data",
   "label": "Product",
   "reqd": 1,
   "placeholder": "Product name"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_product_test",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "test_name",
   "fieldtype": "Autocomplete",
   "label": "Test",
   "reqd": 1,
   "description": "From Active lab libraries \u2014 interrelated with Applicable Standard; includes Other"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_standard_lab",
   "fieldtype": "Section Break",
   "label": "Standard & Lab"
  },
  {
   "doctype": "DocField",
   "fieldname": "applicable_standard",
   "fieldtype": "Autocomplete",
   "label": "Applicable Standard",
   "description": "Standards related to the selected Test Name across labs \u2014 includes Other; then pick a lab that has that standard"
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_standard",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_offer",
   "fieldtype": "Autocomplete",
   "label": "Lab Offer (buying rate compare)",
   "description": "Labs that offer this test/standard with buying & selling rates \u2014 select one"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_samples_lab",
   "fieldtype": "Section Break",
   "label": "Samples & Laboratory"
  },
  {
   "doctype": "DocField",
   "fieldname": "number_of_samples",
   "fieldtype": "Int",
   "label": "Number of Samples",
   "default": 1,
   "description": "Creates linked Sample Tracking rows when the Testing Request is saved"
  },
  {
   "doctype": "DocField",
   "fieldname": "sample_tracking_html",
   "fieldtype": "HTML",
   "label": "Sample Tracking",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_test_scope",
   "fieldtype": "Autocomplete",
   "label": "Lab Test / Scope",
   "description": "Accredited test from the selected lab"
  },
  {
   "doctype": "DocField",
   "fieldname": "suggested_selling_price",
   "fieldtype": "Currency",
   "label": "Selling Price",
   "read_only": 0,
   "options": "price_currency",
   "description": "Case handler can edit — used for customer sell / invoice records"
  },
  {
   "doctype": "DocField",
   "fieldname": "library_buying_price",
   "fieldtype": "Currency",
   "label": "Buying Price",
   "read_only": 0,
   "options": "price_currency",
   "description": "Case handler can edit — used for lab purchase invoices"
  },
  {
   "doctype": "DocField",
   "fieldname": "price_currency",
   "fieldtype": "Link",
   "options": "Currency",
   "label": "Currency",
   "default": "INR",
   "description": "Currency for buying and selling prices",
   "reqd": 0
  },
  {
   "doctype": "DocField",
   "fieldname": "lab_scope_row",
   "fieldtype": "Data",
   "label": "Lab Scope Row",
   "read_only": 1,
   "hidden": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "laboratory",
   "fieldtype": "Link",
   "options": "IC Laboratory",
   "label": "Laboratory",
   "description": "Filled from Lab Offer, or pick an Active lab manually"
  },
  {
   "doctype": "DocField",
   "fieldname": "laboratory_location",
   "fieldtype": "Data",
   "label": "Laboratory Location",
   "fetch_from": "laboratory.location",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "Additional Tests"
  },
  {
   "doctype": "DocField",
   "fieldname": "test_items",
   "fieldtype": "Table",
   "label": "Test Items",
   "options": "IC Testing Request Item"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_report",
   "fieldtype": "Section Break",
   "label": "Report"
  },
  {
   "doctype": "DocField",
   "fieldname": "test_report",
   "fieldtype": "Attach",
   "label": "Test Report"
  },
  {
   "doctype": "DocField",
   "fieldname": "report_shared_on",
   "fieldtype": "Datetime",
   "label": "Report Shared On",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "share_token",
   "fieldtype": "Data",
   "label": "Share Token",
   "read_only": 1,
   "hidden": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "share_access_code",
   "fieldtype": "Data",
   "label": "Share Access Code",
   "read_only": 1,
   "description": "8-digit code the customer enters on the share link"
  },
  {
   "doctype": "DocField",
   "fieldname": "qr_code",
   "fieldtype": "Attach Image",
   "label": "QR Code",
   "read_only": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "section_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "remarks",
   "fieldtype": "Text Editor",
   "label": "Remarks"
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
