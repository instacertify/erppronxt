{
 "name": "IC Document Checklist Template",
 "autoname": "field:template_name",
 "naming_rule": "By fieldname",
 "module": "Instacertify",
 "track_changes": 1,
 "title_field": "template_name",
 "search_fields": "service_name,category",
 "fields": [
  {
   "doctype": "DocField",
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "service_name",
   "fieldtype": "Data",
   "label": "Service",
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "doctype": "DocField",
   "fieldname": "category",
   "fieldtype": "Select",
   "label": "Category",
   "options": "General\nBIS / CRS\nTEC\nWPC\nTesting\nRenewal\nCustom",
   "default": "General",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": 1,
   "in_list_view": 1
  },
  {
   "doctype": "DocField",
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  },
  {
   "doctype": "DocField",
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "Collection Sheet Rows"
  },
  {
   "doctype": "DocField",
   "fieldname": "items_help",
   "fieldtype": "HTML",
   "options": "<p class=\"text-muted\">Add each row the customer must complete. Choose <b>Upload File</b> for document uploads or <b>Fill Field</b> for text the customer types. Mark Mandatory when required.</p>"
  },
  {
   "doctype": "DocField",
   "fieldname": "items",
   "fieldtype": "Table",
   "label": "Rows",
   "options": "IC Document Checklist Item",
   "reqd": 1
  }
 ],
 "permissions": [
  {
   "doctype": "DocPerm",
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Admin",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Senior Operations",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Operations Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 1,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  },
  {
   "doctype": "DocPerm",
   "role": "IC Sales Person",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 0,
   "submit": 0,
   "cancel": 0,
   "amend": 0,
   "report": 1,
   "export": 0,
   "import": 0,
   "share": 1,
   "print": 1,
   "email": 1
  }
 ],
 "doctype": "DocType",
 "engine": "InnoDB"
}
